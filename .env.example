# Reactor (server-side only — never exposed to the browser)
REACTOR_API_KEY=rk_...

# Anthropic — the Director LLM. Leave unset if you use `ant auth login`.
ANTHROPIC_API_KEY=

# Director model. claude-haiku-4-5 is the latency pick (<4s turn target).
# Swap to claude-sonnet-5 if turns feel dumb and latency allows.
DIRECTOR_MODEL=claude-haiku-4-5

# Runware — only needed for scripts/gen_refs.js (starting-frame images)
RUNWARE_API_KEY=

# true  = NPC dialogue is spoken inside the generated clip (FastH3 supports it)
# false = clips are ambient-only; the browser speaks NPC lines via speechSynthesis
DIALOGUE_IN_CLIP=true

# true = prefer cached clips over live generation (the demo parachute)
DEMO_MODE=false

PORT=3000
