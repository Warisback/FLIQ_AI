{
  "name": "understudy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "build:web": "esbuild web/main.js --bundle --format=esm --external:./wasm/reactor_wasm.js --outfile=web/bundle.js && esbuild scripts/smoke.js --bundle --format=esm --external:./wasm/reactor_wasm.js --outfile=web/smoke.bundle.js",
    "dev": "npm run build:web && npm start",
    "gen:refs": "node scripts/gen_refs.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@reactor-team/js-sdk": "^3.0.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0"
  }
}
